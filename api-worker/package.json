{
    "private": true,
    "name": "fuelwatch-api",
    "version": "1.0.0",
    "description": "Validated FuelWatch data for the Home Assistant integration",
    "main": "src/index.ts",
    "scripts": {
        "dev": "wrangler dev",
        "deploy": "wrangler deploy",
        "start": "wrangler dev",
        "format": "biome check --write .",
        "generate-types": "wrangler types",
        "db:migrate:local": "wrangler d1 migrations apply FUELWATCH_DB --local",
        "db:migrate:remote": "wrangler d1 migrations apply FUELWATCH_DB --remote",
        "type-check": "pnpm run generate-types && tsc --noEmit",
        "lint": "biome check .",
        "test": "wrangler deploy --dry-run --outdir dist/test && node --test tests/*.test.mjs",
        "build": "wrangler deploy --dry-run --outdir dist/build"
    },
    "license": "MIT",
    "devDependencies": {
        "@biomejs/biome": "2.5.0",
        "@total-typescript/ts-reset": "^0.6.1",
        "@types/node": "^26.6.3",
        "@types/sax": "1.2.7",
        "esbuild": "0.28.1",
        "miniflare": "5.20260926.0-alpha",
        "typed-query-selector": "^2.12.2",
        "typescript": "^5.5.2",
        "wrangler": "^4.142.0"
    },
    "dependencies": {
        "libphonenumber-js": "^1.13.14",
        "rss-parser": "^3.13.0",
        "sax": "1.6.1"
    },
    "packageManager": "pnpm@11.6.0",
    "engines": {
        "node": ">=24.0.0"
    }
}
