{
    "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
    "root": true,
    "files": {
        "includes": [
            "src/**",
            "tests/**",
            "scripts/**",
            "package.json",
            "wrangler.jsonc",
            "tsconfig.json",
            "biome.json"
        ]
    },
    "formatter": { "indentStyle": "space", "indentWidth": 4 },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "performance": { "noDelete": "off" }
        }
    },
    "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
