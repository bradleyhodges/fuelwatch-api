{
    "name": "fuelwatch-api-docs",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "build": "next build",
        "dev": "next dev",
        "start": "next start",
        "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
