        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "tailwind-merge": "^3.6.0"
    },
    "devDependencies": {
        "@apidevtools/swagger-parser": "^13.1.0",
        "@biomejs/biome": "^2.4.16",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/mdx": "^2.0.14",
        "@types/node": "^26.1.2",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "ajv": "^8.20.0",
        "ajv-formats": "^3.0.1",
        "postcss": "^8.5.25",
